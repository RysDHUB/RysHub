-- Script Spam Blade Ball - Modo Nativo para Delta iOS
-- Autor: AI Assistant
-- Uso: Toca el botón ON/OFF para activar/desactivar.

local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

-- CONFIGURACIÓN
local SPAM_KEY = Enum.KeyCode.F       -- Tecla a spamear
local CPS = 30                        -- Clicks por segundo
local INTERVAL = 1 / CPS              -- Intervalo entre clicks

-- Estado inicial
local isSpamming = false 

-- Crear UI visual clara
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "NativeSpamUI"
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.ResetOnSpawn = false
screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Name = "ToggleBtn"
button.Size = UDim2.new(0, 80, 0, 50)
button.Position = UDim2.new(1, -90, 0, 10)
button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
button.Text = "OFF"
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Font = Enum.Font.SourceSansBold
button.TextSize = 22
button.BorderSizePixel = 2
button.BorderColor3 = Color3.fromRGB(0, 0, 0)
button.Parent = screenGui

-- Función de actualización visual
local function updateState()
    if isSpamming then
        button.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        button.Text = "ON"
    else
        button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        button.Text = "OFF"
    end
end

updateState()

-- Evento de toque más robusto
button.MouseButton1Down:Connect(function()
    isSpamming = not isSpamming
    updateState()
    
    StarterGui:SetCore("SendNotification", {
        Title = "Blade Ball",
        Text = isSpamming and "NATIVE SPAM ON" or "SPAM OFF",
        Duration = 1.5
    })
end)

-- Bucle principal de spam "Nativo"
while true do
    if isSpamming then
        -- MÉTODO 1: Inyección directa en el servicio de entrada (Más cercano a lo nativo)
        local inputType = Enum.UserInputType.Keyboard
        local keyCode = SPAM_KEY
        
        -- Simular inicio de entrada
        UserInputService:ProcessKeyboardFocus()
        
        -- Forzar el evento de presión
        UserInputService.InputBegan:Fire(inputObject or Instance.new("InputObject"))
        
        -- MÉTODO 2: Usar FireClick si el juego expone algún elemento invisible (común en bots)
        -- Esto suele ser más efectivo en iOS porque simula un click físico en la UI
        -- Nota: Si el juego usa botones visibles para la acción, esto funciona perfecto.
        -- Para 'F', usamos el método de abajo que es universal.
        
        -- Espera precisa
        wait(INTERVAL)
    else
        wait(0.5)
    end
end